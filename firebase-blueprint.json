{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store inventory product item with specifications and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "ratingCount": { "type": "number" },
        "stock": { "type": "number" },
        "images": { "type": "array" },
        "featured": { "type": "boolean" },
        "tags": { "type": "array" },
        "sku": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "category", "rating", "ratingCount", "stock", "images"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer ratings and written reviews for products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "recommend": { "type": "boolean" },
        "verifiedPurchase": { "type": "boolean" },
        "helpfulCount": { "type": "number" },
        "helpfulUserIds": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "title", "comment", "verifiedPurchase", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with shipping information and tracking events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "carrier": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "timeline": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "customerEmail", "items", "total", "status", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user account profile and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of catalog items with live stock, specifications, and ratings"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "User reviews and star ratings per product"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders with timeline milestones and shipping status"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and RBAC assignment"
    }
  }
}
